{{!< default}}

<div class="editorial-home-container">

    {{#author}}
    <header class="authors-hub-header">
        <div class="hub-badge">AUTHOR PROFILE</div>
        <h1 class="hub-title">{{name}}</h1>
        {{#if bio}}
            <p class="hub-subtitle">{{bio}}</p>
        {{/if}}
        <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1rem;">
            <a href="{{@site.url}}/authors/#{{slug}}" class="action-icon-btn">View Full Agora Profile &rarr;</a>
        </div>
    </header>
    {{/author}}

    <section class="dispatches-stream">
        {{#foreach posts}}
        <article class="dispatch-card {{post_class}}">
            <div class="dispatch-content">
                <div class="dispatch-header-meta">
                    {{#primary_tag}}
                        <span class="tag-badge">{{name}}</span>
                    {{/primary_tag}}
                    <span class="reading-time-pill">⏱ {{reading_time}}</span>
                    <time datetime="{{date format="YYYY-MM-DD"}}" class="author-mini-date">&bull; {{date format="MMM D"}}</time>
                </div>

                <h2 class="dispatch-title">
                    <a href="{{url}}">{{title}}</a>
                </h2>

                <p class="dispatch-excerpt">{{excerpt words="24"}}...</p>

                <div class="dispatch-footer">
                    <a href="{{url}}" class="dispatch-author-link">Read Story &rarr;</a>

                    <div class="dispatch-actions">
                        <button class="action-icon-btn clap-btn" title="Clap">
                            <span>👏</span>
                            <span class="clap-count">0</span>
                        </button>
                    </div>
                </div>
            </div>

            {{#if feature_image}}
            <a href="{{url}}" class="dispatch-thumb-wrap">
                <img src="{{img_url feature_image size="s"}}" alt="{{title}}" class="dispatch-thumb-img" loading="lazy" />
            </a>
            {{/if}}
        </article>
        {{/foreach}}
    </section>

    {{pagination}}

</div>
