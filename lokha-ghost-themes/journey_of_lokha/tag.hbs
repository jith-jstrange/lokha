{{!< default}}

{{#tag}}
<section class="site-hero">
    <div class="hero-box">
        <span class="hero-badge">Tag Archive</span>
        <h1 class="hero-title">{{name}}</h1>
        {{#if description}}
            <p class="hero-description">{{description}}</p>
        {{/if}}
    </div>
</section>
{{/tag}}

<main class="main-content">
    <div class="post-feed">
        {{#foreach posts}}
            <article class="post-card">
                {{#if feature_image}}
                    <a href="{{url}}" class="post-card-media">
                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                    </a>
                {{/if}}

                <div class="post-card-body">
                    <div class="post-card-meta">
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM DD, YYYY"}}</time>
                    </div>

                    <h3 class="post-card-title">
                        <a href="{{url}}">{{title}}</a>
                    </h3>

                    <p class="post-card-excerpt">
                        {{excerpt words="26"}}...
                    </p>

                    <div class="post-card-footer">
                        {{#primary_author}}
                            <a href="{{url}}" class="author-link">
                                {{#if profile_image}}
                                    <img class="author-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}">
                                {{/if}}
                                <span>{{name}}</span>
                            </a>
                        {{/primary_author}}
                        <span>{{reading_time}}</span>
                    </div>
                </div>
            </article>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
