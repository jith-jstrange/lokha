{{!< default}}

{{#post}}
<article class="post-reading-wrapper {{post_class}}">

    {{! Minimal Distraction-Free Header }}
    <header class="post-reading-header">
        <div class="post-reading-meta">
            {{#primary_tag}}
                <span class="tag-badge">{{name}}</span>
            {{/primary_tag}}
            <span class="reading-time-pill">⏱ {{reading_time}}</span>
            <time datetime="{{date format="YYYY-MM-DD"}}" class="author-mini-date">{{date format="MMMM D, YYYY"}}</time>
        </div>

        <h1 class="post-reading-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="post-reading-excerpt">{{custom_excerpt}}</p>
        {{/if}}

        <div class="post-reading-author-bar">
            {{#foreach authors}}
            <a href="{{@site.url}}/authors/#{{slug}}" class="author-pill">
                {{#if profile_image}}
                    <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="author-mini-avatar" />
                {{/if}}
                <div>
                    <span class="author-mini-name">{{name}}</span>
                    <div class="author-mini-date">Lokha Chronicler</div>
                </div>
            </a>
            {{/foreach}}

            <div class="dispatch-actions">
                <button class="action-icon-btn clap-btn" title="Clap for this story">
                    <span>👏</span>
                    <span class="clap-count" id="clap-count-{{slug}}">0</span>
                </button>
                <button class="action-icon-btn" onclick="toggleBookmark('{{encode title}}', '{{slug}}', '{{url}}')" title="Save to Reading List">
                    <span>🔖 Save</span>
                </button>
            </div>
        </div>
    </header>

    {{! Feature Image }}
    {{#if feature_image}}
    <figure class="post-reading-image-wrap">
        <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="post-reading-image" loading="eager" />
        {{#if feature_image_caption}}
            <figcaption class="post-reading-caption">{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    {{! Pure Readable Content }}
    <section class="post-reading-content gh-content gh-canvas">
        {{content}}
    </section>

    {{! Lokha Universal Creator Tipping & Micro-Royalty Box (Zero Raw Wallets) }}
    <div class="lokha-pay-box">
        <div class="lokha-pay-title">
            <span>⚡</span> LOKHA PAY &bull; VALUE FOR VALUE
        </div>
        <p class="lokha-pay-desc">
            Enjoyed this dispatch? Stream micro-royalties ($0.10–$5.00) directly to the author through Lokha's private settlement gateway.
        </p>
        <div class="lokha-pay-btn-group">
            <button type="button" class="lokha-pay-main-btn" data-lokha-pay data-author-id="{{#primary_author}}{{slug}}{{else}}lokhatoday{{/primary_author}}" data-author-name="{{#primary_author}}{{name}}{{else}}Lokha Creator{{/primary_author}}">
                <span>⚡</span> Tip Author via Lokha Pay
            </button>
            <button type="button" class="lokha-pay-chip" data-lokha-pay data-author-id="{{#primary_author}}{{slug}}{{else}}lokhatoday{{/primary_author}}" data-author-name="{{#primary_author}}{{name}}{{else}}Lokha Creator{{/primary_author}}">$0.50</button>
            <button type="button" class="lokha-pay-chip" data-lokha-pay data-author-id="{{#primary_author}}{{slug}}{{else}}lokhatoday{{/primary_author}}" data-author-name="{{#primary_author}}{{name}}{{else}}Lokha Creator{{/primary_author}}">$1.00</button>
            <button type="button" class="lokha-pay-chip" data-lokha-pay data-author-id="{{#primary_author}}{{slug}}{{else}}lokhatoday{{/primary_author}}" data-author-name="{{#primary_author}}{{name}}{{else}}Lokha Creator{{/primary_author}}">$5.00</button>
        </div>
    </div>

    {{! Minimal Bottom Bar with Claps, Share & Back to Feed }}
    <footer class="post-reading-footer">
        <div class="dispatch-actions">
            <button class="action-icon-btn clap-btn" title="Clap for story">
                <span>👏 Applaud Story</span>
            </button>
            <button class="action-icon-btn" onclick="toggleBookmark('{{encode title}}', '{{slug}}', '{{url}}')" title="Save story">
                <span>🔖 Save Story</span>
            </button>
        </div>

        <a href="{{@site.url}}" class="action-icon-btn">&larr; Back to Dispatches Feed</a>
    </footer>

    {{! Native Ghost Comments }}
    {{#if comments}}
        <section style="margin-top: 3rem; padding-top: 2rem; border-top: 1.5px solid var(--color-border-subtle);">
            <h3 style="font-family: var(--font-display); font-size: 1.3rem; margin-bottom: 1.5rem;">Reader Dialogue</h3>
            {{comments}}
        </section>
    {{/if}}

</article>
{{/post}}
