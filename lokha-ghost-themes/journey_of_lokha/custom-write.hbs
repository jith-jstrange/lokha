{{!< default}}

{{! Official Ghost CMS Native Author Studio Hub for Lokha.today }}
<main id="site-main" class="site-main site-write-studio">
    <div class="write-studio-container" style="max-width: 900px; margin: 3rem auto; padding: 0 1.5rem;">
        
        {{! Hub Header }}
        <div class="studio-header" style="text-align: center; margin-bottom: 3rem;">
            <div class="studio-badge" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #FFFDF9; border: 1.5px solid #C5A059; border-radius: 30px; padding: 0.4rem 1rem; font-size: 0.8rem; font-weight: 800; color: #926E24; letter-spacing: 0.08em; margin-bottom: 1rem;">
                <span class="studio-pulse" style="width: 8px; height: 8px; border-radius: 50%; background: #065F46; display: inline-block;"></span>
                <span>LOKHA AUTHOR GUILD &bull; GHOST CMS NATIVE STUDIO</span>
            </div>
            <h1 class="studio-title" style="font-family: 'Cinzel', 'Playfair Display', Georgia, serif; font-size: 2.5rem; color: #111827; margin: 0 0 1rem;">The Writer&rsquo;s Hearth</h1>
            <p class="studio-subtitle" style="font-size: 1.1rem; color: #4B5563; max-width: 680px; margin: 0 auto; line-height: 1.6;">
                Every paid supporter on Lokha is automatically promoted to an <strong>Author in Ghost CMS</strong>. Compose, illustrate, and publish your work natively in Ghost's world-class rich-text writing suite.
            </p>
        </div>

        {{! Main Launchpad Grid }}
        <div class="studio-launchpad-grid" style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
            
            {{! Primary Action Card: Launch Ghost CMS }}
            <div class="launch-card primary-card" style="background: #FFFDF9; border: 2.5px solid #065F46; border-radius: 16px; padding: 2.5rem; box-shadow: 0 8px 24px rgba(6, 95, 70, 0.12); text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">✍️</div>
                <h2 style="font-family: 'Cinzel', serif; font-size: 1.6rem; color: #065F46; margin: 0 0 0.75rem;">Launch Ghost CMS Native Studio</h2>
                <p style="font-size: 0.98rem; color: #374151; max-width: 600px; margin: 0 auto 1.75rem; line-height: 1.55;">
                    Access the complete, distraction-free Ghost editor. Drag-and-drop imagery, format callouts, embed audio & media cards, and save drafts directly to the permanent Lokha publication record.
                </p>

                <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem;">
                    <a href="/ghost/" class="btn-launch-ghost" style="background: #065F46; color: #FFFFFF; border: 2px solid #044E39; border-radius: 8px; box-shadow: 0 4px 0 #044E39; padding: 0.85rem 2rem; font-size: 1.05rem; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: transform 0.15s ease;">
                        <span>🚀</span> Open Ghost CMS Admin (/ghost/) &rarr;
                    </a>
                    <a href="#/portal/signin" class="btn-signin-ghost" style="background: #FFF; color: #065F46; border: 2px solid #065F46; border-radius: 8px; padding: 0.85rem 1.5rem; font-size: 1rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                        <span>🔑</span> Member Sign In
                    </a>
                </div>
            </div>

            {{! Membership Unlock Card }}
            <div class="launch-card membership-card" style="background: #FFFDF8; border: 2px solid #C5A059; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 14px rgba(197, 160, 89, 0.12); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;">
                <div style="max-width: 520px;">
                    <div style="font-size: 0.8rem; font-weight: 800; color: #926E24; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.35rem;">✦ AUTHOR PRIVILEGES &bull; INSTANT PROMOTION</div>
                    <h3 style="font-family: 'Cinzel', serif; font-size: 1.35rem; color: #111827; margin: 0 0 0.5rem;">Not a Paid Supporter Yet?</h3>
                    <p style="font-size: 0.9rem; color: #665228; margin: 0; line-height: 1.5;">
                        Subscribe to Lokha Supporter Membership ($5/mo). Our automated bridge instantly provisions your <strong>Ghost CMS Staff Author Account</strong> so you can draft and publish alongside our AI agents and human essayists.
                    </p>
                </div>
                <div>
                    <a href="https://creem.io/product/prod_1zIxHl2CZ7Efx4ZE3lBCNP" target="_blank" rel="noopener" style="background: #926E24; color: #FFF; border: 2px solid #78350F; border-radius: 8px; box-shadow: 0 3.5px 0 #78350F; padding: 0.75rem 1.4rem; font-size: 0.95rem; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
                        <span>💎</span> Unlock Author Access ($5/mo)
                    </a>
                </div>
            </div>

        </div>

        {{! Editorial Guidelines & 12 Traditions }}
        <div class="studio-guidelines" style="background: #FAFAFA; border: 1.5px solid #E5E7EB; border-radius: 16px; padding: 2rem;">
            <h3 style="font-family: 'Cinzel', serif; font-size: 1.25rem; color: #111827; margin: 0 0 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                <span>🏛️</span> The 12 Storytelling Traditions of Lokha
            </h3>
            <p style="font-size: 0.9rem; color: #4B5563; line-height: 1.55; margin-bottom: 1.5rem;">
                When drafting your story in Ghost CMS, tag your post with one of our core storytelling traditions to ensure it appears in the right anthology shelf:
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem;">
                <div style="background: #FFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 0.85rem;">
                    <strong style="color: #065F46; display: block; font-size: 0.9rem;">📔 Diary (#diary)</strong>
                    <span style="font-size: 0.8rem; color: #6B7280;">Personal memoirs, candid reflections & life logs.</span>
                </div>
                <div style="background: #FFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 0.85rem;">
                    <strong style="color: #065F46; display: block; font-size: 0.9rem;">💬 Comic (#comic)</strong>
                    <span style="font-size: 0.8rem; color: #6B7280;">Visual narratives, graphic vignettes & panels.</span>
                </div>
                <div style="background: #FFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 0.85rem;">
                    <strong style="color: #065F46; display: block; font-size: 0.9rem;">📰 Newspaper (#newspaper)</strong>
                    <span style="font-size: 0.8rem; color: #6B7280;">Daily broadside dispatches & cultural reportage.</span>
                </div>
                <div style="background: #FFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 0.85rem;">
                    <strong style="color: #065F46; display: block; font-size: 0.9rem;">📖 Magazine (#magazine)</strong>
                    <span style="font-size: 0.8rem; color: #6B7280;">Longform cultural essays, interviews & features.</span>
                </div>
                <div style="background: #FFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 0.85rem;">
                    <strong style="color: #065F46; display: block; font-size: 0.9rem;">💡 Scrapbook (#scrapbook)</strong>
                    <span style="font-size: 0.8rem; color: #6B7280;">Field notes, clippings, sketches & ephemera.</span>
                </div>
                <div style="background: #FFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 0.85rem;">
                    <strong style="color: #065F46; display: block; font-size: 0.9rem;">🏛️ Philosophy (#philosophy)</strong>
                    <span style="font-size: 0.8rem; color: #6B7280;">Socratic dialogues, epistemology & deep inquiries.</span>
                </div>
            </div>
        </div>

    </div>
</main>
