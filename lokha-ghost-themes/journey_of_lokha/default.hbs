            <nav class="floating-nav">
                
                {{! Brand & Wordmark }}
                <div class="nav-left">
                    <a href="{{@site.url}}" class="nav-logo-link">
                        <img src="{{asset "images/lokha-logo.png"}}" alt="{{@site.title}}" class="nav-logo-emblem" />
                        <span class="nav-brand-title">LOKHA</span>
                    </a>
                </div>

                {{! Desktop Nav Center (Zero Dots) }}
                <div class="nav-center">
                    {{#if @site.navigation}}
                        {{navigation}}
                    {{else}}
                        <ul class="nav-list">
                            <li class="nav-item"><a href="{{@site.url}}" class="nav-link">Home</a></li>
                            <li class="nav-item"><a href="{{@site.url}}/authors/" class="nav-link">Authors</a></li>
                            <li class="nav-item"><a href="{{@site.url}}/store/" class="nav-link">Store</a></li>
                            <li class="nav-item"><a href="{{@site.url}}/about/" class="nav-link">About</a></li>
                            <li class="nav-item"><a href="{{@site.url}}/membership/" class="nav-link">Membership</a></li>
                            <li class="nav-item"><a href="{{@site.url}}/archive/" class="nav-link">Archive</a></li>
                        </ul>
                    {{/if}}
                </div>

                {{! Nav Actions }}
                <div class="nav-right">
                    
                    {{! Search Button }}
                    <button class="nav-btn nav-search-btn" data-ghost-search aria-label="Search stories" title="Search (Ctrl+K)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>

                    {{! Write Studio Button }}
                    <a href="{{@site.url}}/write/" class="nav-btn write-nav-btn" style="background: #065F46; color: #FFFFFF; border-color: #044E39; font-weight: 800;" title="Compose a Dispatch">✍️ Write</a>

                    {{! Member Auth Buttons }}
                    {{#if @member}}
                        <a href="{{@site.url}}/account/" class="nav-btn" title="{{@member.email}}">Account</a>
                    {{else}}
                        <a href="#/portal/signup" class="nav-btn subscribe-btn">Join</a>
                    {{/if}}

                    {{! Animated Morphing Hamburger Menu Button }}
                    <button class="nav-btn menu-morph-btn" id="mobile-menu-toggle" aria-label="Toggle navigation menu">
                        <div class="hamburger-morph-icon">
                            <span class="bar line-1"></span>
                            <span class="bar line-2"></span>
                            <span class="bar line-3"></span>
                        </div>
                        <span class="menu-label-text">Menu</span>
                    </button>

                </div>
            </nav>
        </header>

        {{! Off-Canvas Global Slide-out Drawer (Zero Dots) }}
