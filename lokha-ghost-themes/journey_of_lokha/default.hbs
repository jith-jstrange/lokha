                <button class="mobile-drawer-close" id="mobile-drawer-close" aria-label="Close navigation">&times;</button>
            </div>

            <div class="mobile-drawer-body">
                <nav class="mobile-nav-links">
                    <a href="{{@site.url}}" class="mobile-nav-item">🏠 Home</a>
                    <a href="{{@site.url}}/write/" class="mobile-nav-item" style="font-weight: 800; color: #065F46; background: #ECFDF5;">✍️ Author Studio (Compose)</a>
                    <a href="{{@site.url}}/authors/" class="mobile-nav-item">🏛️ Authors & Chroniclers</a>
                    <a href="{{@site.url}}/account/" class="mobile-nav-item">👤 Member Account & Bookmarks</a>
                    <a href="{{@site.url}}/store/" class="mobile-nav-item">🛍️ Digital Store</a>
                    <a href="{{@site.url}}/about/" class="mobile-nav-item">📖 About Lokha & Manifesto</a>
                    <a href="{{@site.url}}/membership/" class="mobile-nav-item">🌟 Supporter Membership ($5/mo)</a>
                    <a href="{{@site.url}}/archive/" class="mobile-nav-item">🗄️ Global Archives</a>
                    <a href="{{@site.url}}/privacy/" class="mobile-nav-item">🔒 Privacy Policy</a>
                    <a href="{{@site.url}}/terms/" class="mobile-nav-item">⚖️ Terms of Service</a>
                </nav>

                <div class="mobile-drawer-divider"></div>

                <div class="mobile-traditions-section">
                    <span class="mobile-section-label">12 Storytelling Traditions</span>
                    <div class="mobile-traditions-grid">
                        <a href="{{@site.url}}/tag/diary/" class="mobile-trad-pill">📔 Diary</a>
                        <a href="{{@site.url}}/tag/comic/" class="mobile-trad-pill">💬 Comic</a>
                        <a href="{{@site.url}}/tag/newspaper/" class="mobile-trad-pill">📰 Newspaper</a>
                        <a href="{{@site.url}}/tag/magazine/" class="mobile-trad-pill">📖 Magazine</a>
                        <a href="{{@site.url}}/tag/scrapbook/" class="mobile-trad-pill">💡 Scrapbook</a>
                        <a href="{{@site.url}}/tag/letters/" class="mobile-trad-pill">✉️ Letters</a>
                        <a href="{{@site.url}}/tag/poetry/" class="mobile-trad-pill">📜 Poetry</a>
                        <a href="{{@site.url}}/tag/oral/" class="mobile-trad-pill">🎙️ Oral</a>
                        <a href="{{@site.url}}/tag/dialogue/" class="mobile-trad-pill">🏛️ Dialogue</a>
                        <a href="{{@site.url}}/tag/travelogue/" class="mobile-trad-pill">🗺️ Travel</a>
                        <a href="{{@site.url}}/tag/parable/" class="mobile-trad-pill">🔮 Parables</a>
                        <a href="{{@site.url}}/tag/codex/" class="mobile-trad-pill">📐 Codex</a>
