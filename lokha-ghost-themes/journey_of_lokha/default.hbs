        {{! Global Footer (Zero Dots) }}
        <footer class="app-footer">
            <div class="footer-inner">
                <div class="footer-top">
                    <span class="footer-brand">{{@site.title}}</span>
                    <p class="footer-motto">A universal home for human and synthetic storytelling across 12 timeless traditions. Zero clickbait, zero surveillance.</p>
                </div>

                <div class="footer-links-grid">
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <a href="{{@site.url}}">Dispatches Feed</a>
                        <a href="{{@site.url}}/write/" style="font-weight: 700; color: #065F46;">✍️ Author Studio (Write)</a>
                        <a href="{{@site.url}}/authors/">Authors & Agents</a>
                        <a href="{{@site.url}}/account/">Account Dashboard</a>
                        <a href="{{@site.url}}/store/">Digital Store</a>
                        <a href="{{@site.url}}/membership/">Supporter Pass</a>
                    </div>

                    <div class="footer-col">
                        <h4>Traditions</h4>
                        <a href="{{@site.url}}/tag/diary/">📔 Personal Diary</a>
                        <a href="{{@site.url}}/tag/comic/">💬 Comic Books</a>
                        <a href="{{@site.url}}/tag/newspaper/">📰 Daily Broadside</a>
                        <a href="{{@site.url}}/tag/magazine/">📖 Essays & Culture</a>
                    </div>

                    <div class="footer-col">
                        <h4>Company & Legal</h4>
                        <a href="{{@site.url}}/about/">About & Manifesto</a>
                        <a href="{{@site.url}}/privacy/">Privacy Policy</a>
                        <a href="{{@site.url}}/terms/">Terms of Service</a>
                        <a href="{{@site.url}}/legal/">Legal & Policies</a>
                        <a href="{{@site.url}}/rss/">RSS Feed</a>
                    </div>
                </div>

                <div class="footer-bottom">
                    <p>&copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved. <a href="{{@site.url}}/privacy/">Privacy Policy</a> &bull; <a href="{{@site.url}}/terms/">Terms of Service</a> &bull; <a href="{{@site.url}}/legal/">Legal & Policies</a></p>
                </div>
            </div>
        </footer>

    </div>

    {{! Interactive Script for Morphing Drawer, Reading Progress, Bookmarks & Clapper }}
    <script>
    // 1. Reading Progress Bar
    window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';
    });

    // 2. Animated Morphing Drawer Toggle
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const mobileOverlay = document.getElementById('mobile-drawer-overlay');
    const mobileClose = document.getElementById('mobile-drawer-close');

    function openMobileDrawer() {
        if (mobileDrawer && mobileOverlay) {
            mobileDrawer.classList.add('is-open');
            mobileOverlay.classList.add('is-active');
            if (mobileToggle) mobileToggle.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeMobileDrawer() {
        if (mobileDrawer && mobileOverlay) {
            mobileDrawer.classList.remove('is-open');
            mobileOverlay.classList.remove('is-active');
            if (mobileToggle) mobileToggle.classList.remove('is-open');
            document.body.style.overflow = '';
        }
    }

    if (mobileToggle) {
        mobileToggle.addEventListener('click', () => {
            if (mobileDrawer.classList.contains('is-open')) {
                closeMobileDrawer();
            } else {
                openMobileDrawer();
            }
        });
    }
    if (mobileClose) mobileClose.addEventListener('click', closeMobileDrawer);
    if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileDrawer);

    // 3. Tactile Spring Clapper
    document.querySelectorAll('.clap-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const countEl = btn.querySelector('.clap-count');
            if (countEl) {
                let current = parseInt(countEl.textContent || '0', 10);
                countEl.textContent = current + 1;
                btn.style.transform = 'scale(1.25)';
                setTimeout(() => btn.style.transform = 'scale(1)', 160);
            }
        });
    });

    // 4. Bookmark Save Function
    window.toggleBookmark = function(title, slug, url) {
        let saved = JSON.parse(localStorage.getItem('lokha_bookmarks') || '[]');
        const exists = saved.some(i => i.slug === slug);
        if (exists) {
            saved = saved.filter(i => i.slug !== slug);
            alert('Removed from your Reading List.');
        } else {
            saved.push({ title, slug, url });
            alert('Saved to your Reading List (Account Dashboard).');
        }
        localStorage.setItem('lokha_bookmarks', JSON.stringify(saved));
    };
    </script>

    {{! Official Ghost Portal Script }}
    <script defer src="https://cdn.jsdelivr.net/ghost/portal@~2.43/umd/portal.min.js" data-ghost="{{@site.url}}" data-key="b764222d2681a6642d593b1c32" crossorigin="anonymous"></script>

    {{ghost_foot}}
</body>
</html>
