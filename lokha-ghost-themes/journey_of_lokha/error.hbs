{{!< default}}

<main class="main-content">
    <section class="site-hero">
        <div class="hero-box">
            <span class="hero-badge">Error {{statusCode}}</span>
            <h1 class="hero-title">{{message}}</h1>
            <p class="hero-description">The page you are looking for does not exist or has been moved.</p>
            <p style="margin-top: 1.5rem;">
                <a href="{{@site.url}}" class="btn-ghost-signup">&larr; Return to Home</a>
            </p>
        </div>
    </section>
</main>
