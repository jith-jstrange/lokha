{{!< default}}

{{#post}}
<article class="post-reading-wrapper page-container {{post_class}}">

    {{#match @page.show_title_and_feature_image}}
        <header class="post-reading-header">
            <h1 class="post-reading-title">{{title}}</h1>
        </header>

        {{#if feature_image}}
            <figure class="post-reading-image-wrap">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="post-reading-image" loading="eager" />
            </figure>
        {{/if}}
    {{/match}}

    <section class="post-reading-content gh-content gh-canvas">
        {{content}}
    </section>

</article>
{{/post}}
